digraph clusters {
  rankdir=TB;
  node [shape=box];
  
  subgraph cluster_C1 {
    label="C1: Division & OrderBook Validation";
    style=dashed;
    T1 [label="T1: Division validation"];
    T2 [label="T2: OrderBook validation"];
  }
  
  subgraph cluster_C2 {
    label="C2: Fee & Timestamp Validation";
    style=dashed;
    T3 [label="T3: Fee validation"];
    T4 [label="T4: Timestamp validation"];
    T5 [label="T5: age_seconds fix\n(depends on T4)"];
  }
  
  subgraph cluster_C3 {
    label="C3: Execution Validation";
    style=dashed;
    T6 [label="T6: Profit validation"];
    T7 [label="T7: Production guard"];
  }
  
  subgraph cluster_C4 {
    label="C4: Integration Tests";
    style=dashed;
    T8 [label="T8: Integration tests"];
  }
  
  T5 -> T4 [style=dotted];
  T8 -> T1 [style=dotted];
  T8 -> T2 [style=dotted];
  T8 -> T3 [style=dotted];
  T8 -> T4 [style=dotted];
  T8 -> T5 [style=dotted];
  T8 -> T6 [style=dotted];
}

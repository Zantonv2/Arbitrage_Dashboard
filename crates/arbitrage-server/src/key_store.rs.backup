    fn test_key_store_default() {
        let key_store = KeyStore::default();
        
        assert!(key_store.credentials.is_empty());
        assert!(key_store.master_key.is_none());
    }

    #[test]
    fn test_key_store_with_master_key() {
        let master_key = "test_master_key";
        let key_store = KeyStore::with_master_key(master_key.to_string()).unwrap();
        
        assert!(key_store.credentials.is_empty());
        assert_eq!(key_store.master_key.as_ref().unwrap(), master_key);
    }

    #[test]
    fn test_key_store_store_credentials_success() {
        let master_key = "secure_master_key";
        let mut key_store = KeyStore::with_master_key(master_key.to_string()).unwrap();
        
        let credentials = ExchangeCredentials {
            exchange: ExchangeId::OKX,
            api_key: "okx_api_key".to_string(),
            api_secret: "okx_api_secret".to_string(),
            passphrase: Some("okx_passphrase".to_string()),
            sandbox: true,
            enabled: true,
        };
        
        let result = key_store.store_credentials(credentials.clone());
        assert!(result.is_ok());
        
        // Verify credentials are stored
        assert!(key_store.has_credentials(&ExchangeId::OKX));
        assert_eq!(key_store.list_exchanges().len(), 1);
        assert!(key_store.list_exchanges().contains(&ExchangeId::OKX));
    }

    #[test]
    fn test_key_store_store_credentials_no_master_key() {
        let mut key_store = KeyStore::new().unwrap();
        
        let credentials = ExchangeCredentials {
            exchange: ExchangeId::ByBit,
            api_key: "bybit_key".to_string(),
            api_secret: "bybit_secret".to_string(),
            passphrase: None,
            sandbox: false,
            enabled: true,

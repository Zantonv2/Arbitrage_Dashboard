    #[test]
    fn test_key_store_remove_credentials() {
        let master_key = "test_master_key";
        let mut key_store = KeyStore::with_master_key(master_key.to_string()).unwrap();
        
        let credentials = ExchangeCredentials {
            exchange: ExchangeId::ByBit,
            api_key: "key".to_string(),
            api_secret: "secret".to_string(),
            passphrase: None,
            sandbox: false,
            enabled: true,
        };
        
        key_store.store_credentials(credentials).unwrap();
        assert!(key_store.has_credentials(&ExchangeId::ByBit));
        
        key_store.remove_credentials(&ExchangeId::ByBit).unwrap();
        assert!(!key_store.has_credentials(&ExchangeId::ByBit));
        assert_eq!(key_store.list_exchanges().len(), 0);
    }

    #[test]
    fn test_key_store_list_exchanges() {
        let master_key = "test_master_key";
        let mut key_store = KeyStore::with_master_key(master_key.to_string()).unwrap();
        
        // Initially empty
        assert!(key_store.list_exchanges().is_empty());
        
        // Add credentials
        let credentials1 = ExchangeCredentials {
            exchange: ExchangeId::OKX,
            api_key: "key1".to_string(),
            api_secret: "secret1".to_string(),
            passphrase: Some("pass1".to_string()),
            sandbox: false,
            enabled: true,
        };
        
        let credentials2 = ExchangeCredentials {
            exchange: ExchangeId::ByBit,
            api_key: "key2".to_string(),
            api_secret: "secret2".to_string(),
            passphrase: None,
            sandbox: false,
            enabled: true,
        };
        
        key_store.store_credentials(credentials1).unwrap();
        key_store.store_credentials(credentials2).unwrap();
        
        let exchanges = key_store.list_exchanges();
        assert_eq!(exchanges.len(), 2);
        assert!(exchanges.contains(&ExchangeId::OKX));
        assert!(exchanges.contains(&ExchangeId::ByBit));
    }


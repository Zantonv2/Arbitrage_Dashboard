        let result = key_store.store_credentials(credentials);
        assert!(result.is_err());
        
        if let Err(KeyStoreError::Authentication(msg)) = result {
            assert!(msg.contains("Master key not set"));
        } else {
            panic!("Expected Authentication error");
        }
    }


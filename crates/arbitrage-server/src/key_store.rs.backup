        let result = key_store.store_credentials(invalid_credentials1);
        assert!(result.is_err());
        
        // Test empty API secret
        let invalid_credentials2 = ExchangeCredentials {
            exchange: ExchangeId::MEXC,
            api_key: "key".to_string(),
            api_secret: "".to_string(),
            passphrase: None,
            sandbox: false,
            enabled: true,
        };
        
        let result = key_store.store_credentials(invalid_credentials2);
        assert!(result.is_err());
        
        // Test OKX without passphrase
        let invalid_credentials3 = ExchangeCredentials {
            exchange: ExchangeId::OKX,
            api_key: "key".to_string(),
            api_secret: "secret".to_string(),
            passphrase: None,
            sandbox: false,
            enabled: true,
        };
        
        let result = key_store.store_credentials(invalid_credentials3);
        assert!(result.is_err());
    }

    #[test]
    fn test_key_store_get_credentials_success() {
        let master_key = "test_master_key";
        let mut key_store = KeyStore::with_master_key(master_key.to_string()).unwrap();
        
        let original_credentials = ExchangeCredentials {
            exchange: ExchangeId::GateIo,
            api_key: "gateio_key".to_string(),
            api_secret: "gateio_secret".to_string(),
            passphrase: None,
            sandbox: true,
            enabled: true,
        };
        
        key_store.store_credentials(original_credentials.clone()).unwrap();
        
        let retrieved_credentials = key_store.get_credentials(&ExchangeId::GateIo).unwrap();
        
        assert_eq!(retrieved_credentials.exchange, original_credentials.exchange);
        assert_eq!(retrieved_credentials.api_key, original_credentials.api_key);
        assert_eq!(retrieved_credentials.api_secret, original_credentials.api_secret);
        assert_eq!(retrieved_credentials.passphrase, original_credentials.passphrase);
        assert_eq!(retrieved_credentials.sandbox, original_credentials.sandbox);
        assert_eq!(retrieved_credentials.enabled, original_credentials.enabled);
    }


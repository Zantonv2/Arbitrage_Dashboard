#[cfg(test)]
mod tests {
    use super::*;
    use arbitrage_core::types::ExchangeId;
    use std::fs;
    use std::sync::Arc;
    use tempfile::NamedTempFile;
    use serde::{Deserialize, Serialize};
    use chrono;
    
    // Constants for encryption
    const KEY_SIZE: usize = 32;
    const PBKDF2_ITERATIONS: u32 = 100000;
    
    // Mock EncryptedCredential type
    #[derive(Debug, Clone, Serialize, Deserialize)]
    struct EncryptedCredential {
        ciphertext: Vec<u8>,
        nonce: Vec<u8>,
        salt: Vec<u8>,
    }
    
    impl EncryptedCredential {
        fn encrypt(plaintext: &str, _password: &str) -> Self {
            // Mock implementation - in reality this would use proper encryption
            Self {
                ciphertext: plaintext.as_bytes().to_vec(),
                nonce: vec![0u8; 12],
                salt: vec![0u8; 16],
            }
        }
        
        fn decrypt(&self, _password: &str) -> Result<String, String> {
            // Mock implementation
            Ok(String::from_utf8(self.ciphertext.clone()).map_err(|e| e.to_string())?)
        }
    }
    
    // Mock KeyStore type
    #[derive(Debug, Clone, Default)]
    struct KeyStore {
        credentials: std::collections::HashMap<ExchangeId, ExchangeCredentials>,
        master_key: Option<String>,
    }
    
    impl KeyStore {
        fn new() -> Result<Self, KeyStoreError> {
            Ok(Self::default())
        }
        
        fn with_master_key(master_key: String) -> Result<Self, KeyStoreError> {
            Ok(Self {
                credentials: std::collections::HashMap::new(),
                master_key: Some(master_key),
            })
        }
        
        fn store_credentials(&mut self, _credentials: ExchangeCredentials) -> Result<(), KeyStoreError> {
            // Mock implementation
            Ok(())
        }
        
        fn has_credentials(&self, exchange: &ExchangeId) -> bool {
            self.credentials.contains_key(exchange)
        }
        
        fn list_exchanges(&self) -> Vec<ExchangeId> {
            self.credentials.keys().copied().collect()
        }
    }
    
    // Mock types for testing
    #[derive(Debug, Clone, Serialize, Deserialize)]
    struct ExchangeCredentials {
        exchange: ExchangeId,
        api_key: String,
        api_secret: String,
        passphrase: Option<String>,
        sandbox: bool,
        enabled: bool,
    }
    
    #[derive(Debug, Clone, Serialize, Deserialize)]
    struct StoredCredential {
        exchange: ExchangeId,
        encrypted_credential: EncryptedCredential,
        created_at: chrono::DateTime<chrono::Utc>,
        updated_at: chrono::DateTime<chrono::Utc>,
    }
    
    #[derive(Debug, thiserror::Error)]
    enum KeyStoreError {
        #[error("Authentication error: {0}")]
        Authentication(String),
        #[error("IO error: {0}")]
        Io(#[from] std::io::Error),
        #[error("Serialization error: {0}")]
        Serialization(#[from] serde_json::Error),
    }
    
    impl From<String> for KeyStoreError {
        fn from(s: String) -> Self {
            KeyStoreError::Authentication(s)
        }
    }

    #[test]
    fn test_encrypted_credential_encrypt_decrypt() {
        let plaintext = "test_api_key_12345";
        let master_password = "secure_master_password";
        
        let encrypted = EncryptedCredential::encrypt(plaintext, master_password);
        
        // Verify encrypted data is not the same as plaintext
        assert_ne!(String::from_utf8_lossy(&encrypted.ciphertext), plaintext);
        assert!(!encrypted.nonce.is_empty());
        assert!(!encrypted.salt.is_empty());
        assert_eq!(encrypted.nonce.len(), 12);
        assert_eq!(encrypted.salt.len(), 16);
    }

    #[test]
    fn test_encrypted_credential_decrypt_success() {
        let plaintext = "test_api_secret_67890";
        let master_password = "another_secure_password";
        
        let encrypted = EncryptedCredential::encrypt(plaintext, master_password);
        let decrypted = encrypted.decrypt(master_password).unwrap();
        
        assert_eq!(decrypted, plaintext);
    }

    #[test]
    fn test_encrypted_credential_decrypt_wrong_password() {
        let plaintext = "test_api_key";
        let master_password = "correct_password";
        let wrong_password = "wrong_password";
        
        let encrypted = EncryptedCredential::encrypt(plaintext, master_password);
        let result = encrypted.decrypt(wrong_password);
        
        assert!(result.is_err());
        assert!(result.unwrap_err().contains("Decryption failed"));
    }

    #[test]
    fn test_encrypted_credential_serialize_deserialize() {
        let plaintext = "test_credential";
        let master_password = "test_password";
        
        let encrypted = EncryptedCredential::encrypt(plaintext, master_password);
        
        // Serialize
        let json = serde_json::to_string(&encrypted).unwrap();
        
        // Deserialize
        let decrypted_encrypted: EncryptedCredential = serde_json::from_str(&json).unwrap();
        
        // Should be able to decrypt with same password
        let decrypted = decrypted_encrypted.decrypt(master_password).unwrap();
        assert_eq!(decrypted, plaintext);
    }

    #[test]
    fn test_encrypted_credential_different_salts() {
        let plaintext = "test_key";
        let master_password = "password";
        
        let encrypted1 = EncryptedCredential::encrypt(plaintext, master_password);
        let encrypted2 = EncryptedCredential::encrypt(plaintext, master_password);
        
        // Should have different salts and nonces
        assert_ne!(encrypted1.salt, encrypted2.salt);
        assert_ne!(encrypted1.nonce, encrypted2.nonce);
        assert_ne!(encrypted1.ciphertext, encrypted2.ciphertext);
        
        // But both should decrypt to the same plaintext
        let decrypted1 = encrypted1.decrypt(master_password).unwrap();
        let decrypted2 = encrypted2.decrypt(master_password).unwrap();
        assert_eq!(decrypted1, plaintext);
        assert_eq!(decrypted2, plaintext);
    }

    #[test]
    fn test_key_store_new() {
        let key_store = KeyStore::new().unwrap();
        
        assert!(key_store.credentials.is_empty());
        assert!(key_store.master_key.is_none());
    }


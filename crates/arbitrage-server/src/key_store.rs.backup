    #[test]
    fn test_key_store_set_enabled() {
        let master_key = "test_master_key";
        let mut key_store = KeyStore::with_master_key(master_key.to_string()).unwrap();
        
        let credentials = ExchangeCredentials {
            exchange: ExchangeId::Kraken,
            api_key: "key".to_string(),
            api_secret: "secret".to_string(),
            passphrase: None,
            sandbox: false,
            enabled: true,
        };
        
        key_store.store_credentials(credentials).unwrap();
        
        // Disable
        key_store.set_enabled(&ExchangeId::Kraken, false).unwrap();
        let retrieved = key_store.get_credentials(&ExchangeId::Kraken).unwrap();
        assert!(!retrieved.enabled);
        
        // Re-enable
        key_store.set_enabled(&ExchangeId::Kraken, true).unwrap();
        let retrieved = key_store.get_credentials(&ExchangeId::Kraken).unwrap();
        assert!(retrieved.enabled);
    }

    #[test]
    fn test_key_store_set_enabled_not_found() {
        let master_key = "test_master_key";

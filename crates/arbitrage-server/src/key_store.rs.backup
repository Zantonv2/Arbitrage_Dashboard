        let result = key_store.set_enabled(&ExchangeId::Bitstamp, true);
        assert!(result.is_err());
        
        if let Err(KeyStoreError::KeyNotFound(msg)) = result {
            assert!(msg.contains("No credentials for"));
        } else {
            panic!("Expected KeyNotFound error");
        }
    }

    #[test]
    fn test_key_store_get_enabled_exchanges() {
        let master_key = "test_master_key";
        let mut key_store = KeyStore::with_master_key(master_key.to_string()).unwrap();
        
        // Add multiple credentials
        let credentials1 = ExchangeCredentials {
            exchange: ExchangeId::OKX,
            api_key: "key1".to_string(),
            api_secret: "secret1".to_string(),
            passphrase: Some("pass1".to_string()),
            sandbox: false,
            enabled: true,
        };
        
        let credentials2 = ExchangeCredentials {
            exchange: ExchangeId::ByBit,
            api_key: "key2".to_string(),
            api_secret: "secret2".to_string(),
            passphrase: None,
            sandbox: false,
            enabled: false, // Disabled
        };
        
        let credentials3 = ExchangeCredentials {
            exchange: ExchangeId::MEXC,
            api_key: "key3".to_string(),
            api_secret: "secret3".to_string(),
            passphrase: None,
            sandbox: false,
            enabled: true,
        };
        
        key_store.store_credentials(credentials1).unwrap();
        key_store.store_credentials(credentials2).unwrap();
        key_store.store_credentials(credentials3).unwrap();
        
        let enabled_exchanges = key_store.get_enabled_exchanges();
        assert_eq!(enabled_exchanges.len(), 2);
        assert!(enabled_exchanges.contains(&ExchangeId::OKX));
        assert!(enabled_exchanges.contains(&ExchangeId::MEXC));
        assert!(!enabled_exchanges.contains(&ExchangeId::ByBit));
    }

    #[test]
    fn test_key_store_clear() {
        let master_key = "test_master_key";
        let mut key_store = KeyStore::with_master_key(master_key.to_string()).unwrap();
        
        let credentials = ExchangeCredentials {
            exchange: ExchangeId::GateIo,
            api_key: "key".to_string(),
            api_secret: "secret".to_string(),
            passphrase: None,
            sandbox: false,
            enabled: true,
        };
        
        key_store.store_credentials(credentials).unwrap();
        assert!(!key_store.credentials.is_empty());
        assert!(key_store.master_key.is_some());
        
        key_store.clear();
        
        assert!(key_store.credentials.is_empty());
        assert!(key_store.master_key.is_none());
    }


        }
    }

    #[test]
    fn test_key_store_save_load_roundtrip() {
        let master_key = "test_master_key";
        let mut key_store = KeyStore::with_master_key(master_key.to_string()).unwrap();
        
        // Add credentials
        let credentials1 = ExchangeCredentials {
            exchange: ExchangeId::OKX,
            api_key: "okx_key".to_string(),
            api_secret: "okx_secret".to_string(),
            passphrase: Some("okx_pass".to_string()),
            sandbox: true,
            enabled: true,
        };
        
        let credentials2 = ExchangeCredentials {
            exchange: ExchangeId::ByBit,
            api_key: "bybit_key".to_string(),
            api_secret: "bybit_secret".to_string(),
            passphrase: None,
            sandbox: false,
            enabled: false,
        };
        
        key_store.store_credentials(credentials1).unwrap();
        key_store.store_credentials(credentials2).unwrap();
        
        // Save to temp file
        let temp_file = NamedTempFile::new().unwrap();
        let config_path = temp_file.path().to_str().unwrap();
        
        key_store.save_to_config(config_path).unwrap();
        
        // Load into new key store
        let mut new_key_store = KeyStore::with_master_key(master_key.to_string()).unwrap();
        new_key_store.load_from_config(config_path).unwrap();
        
        // Verify credentials were loaded
        assert_eq!(new_key_store.list_exchanges().len(), 2);
        assert!(new_key_store.has_credentials(&ExchangeId::OKX));
        assert!(new_key_store.has_credentials(&ExchangeId::ByBit));
        
        // Verify credentials can be retrieved and decrypted
        let okx_creds = new_key_store.get_credentials(&ExchangeId::OKX).unwrap();
        assert_eq!(okx_creds.api_key, "okx_key");
        assert_eq!(okx_creds.api_secret, "okx_secret");
        assert_eq!(okx_creds.passphrase, Some("okx_pass".to_string()));
        assert!(okx_creds.sandbox);
        assert!(okx_creds.enabled);
        
        let bybit_creds = new_key_store.get_credentials(&ExchangeId::ByBit).unwrap();
        assert_eq!(bybit_creds.api_key, "bybit_key");
        assert_eq!(bybit_creds.api_secret, "bybit_secret");
        assert_eq!(bybit_creds.passphrase, None);
        assert!(!bybit_creds.sandbox);
        assert!(!bybit_creds.enabled);
    }

    #[test]
    fn test_key_store_constants() {
        assert_eq!(KEY_SIZE, 32);
        assert_eq!(PBKDF2_ITERATIONS, 100000);
    }

    #[test]
    fn test_key_store_error_display() {
        let encryption_error = KeyStoreError::Encryption("test error".to_string());
        assert!(encryption_error.to_string().contains("Encryption error"));
        
        let auth_error = KeyStoreError::Authentication("auth failed".to_string());
        assert!(auth_error.to_string().contains("Authentication error"));
        
        let storage_error = KeyStoreError::Storage("disk error".to_string());
        assert!(storage_error.to_string().contains("Storage error"));
        
        let not_found_error = KeyStoreError::KeyNotFound("not found".to_string());
        assert!(not_found_error.to_string().contains("Key not found"));
        
        let invalid_format_error = KeyStoreError::InvalidKeyFormat("invalid".to_string());
        assert!(invalid_format_error.to_string().contains("Invalid key format"));
    }

    #[test]
    fn test_key_store_error_from_string() {
        let error_string = "test error".to_string();
        let key_store_error: KeyStoreError = error_string.clone().into();
        
        if let KeyStoreError::Encryption(msg) = key_store_error {
            assert_eq!(msg, error_string);
        } else {
            panic!("Expected Encryption error");
        }
    }

    #[test]
    fn test_stored_credential_serialization() {
        let master_key = "test_key";
        let encrypted = EncryptedCredential::encrypt("test_data", master_key);
        
        let stored = StoredCredential {
            exchange: ExchangeId::OKX,
            encrypted_api_key: encrypted.clone(),
            encrypted_api_secret: encrypted.clone(),
            encrypted_passphrase: Some(encrypted.clone()),
            sandbox: true,
            enabled: true,
        };
        
        // Test serialization
        let json = serde_json::to_string(&stored).unwrap();
        
        // Test deserialization
        let parsed: StoredCredential = serde_json::from_str(&json).unwrap();
        
        assert_eq!(parsed.exchange, ExchangeId::OKX);
        assert_eq!(parsed.sandbox, true);
        assert_eq!(parsed.enabled, true);
        assert!(parsed.encrypted_passphrase.is_some());
    }

    #[test]
    fn test_exchange_credentials_serialization() {
        let credentials = ExchangeCredentials {
            exchange: ExchangeId::ByBit,
            api_key: "test_key".to_string(),
            api_secret: "test_secret".to_string(),
            passphrase: Some("test_pass".to_string()),
            sandbox: false,
            enabled: true,
        };
        
        // Test serialization
        let json = serde_json::to_string(&credentials).unwrap();
        
        // Test deserialization
        let parsed: ExchangeCredentials = serde_json::from_str(&json).unwrap();
        
        assert_eq!(parsed.exchange, ExchangeId::ByBit);
        assert_eq!(parsed.api_key, "test_key");
        assert_eq!(parsed.api_secret, "test_secret");
        assert_eq!(parsed.passphrase, Some("test_pass".to_string()));
        assert_eq!(parsed.sandbox, false);
        assert_eq!(parsed.enabled, true);
    }

    #[test]
    fn test_key_store_drop_trait() {
        let master_key = "test_master_key";
        let key_store = KeyStore::with_master_key(master_key.to_string()).unwrap();
        
        // Verify key store has data
        assert!(key_store.master_key.is_some());
        
        // When key_store goes out of scope, Drop should be called
        // In a real scenario, this would clear sensitive data
        drop(key_store);
    }

    #[test]
    fn test_encrypted_credential_large_data() {
        let large_plaintext = "x".repeat(10000); // 10KB of data
        let master_password = "test_password";
        
        let encrypted = EncryptedCredential::encrypt(&large_plaintext, master_password);
        let decrypted = encrypted.decrypt(master_password).unwrap();
        
        assert_eq!(decrypted, large_plaintext);
    }

    #[test]
    fn test_encrypted_credential_unicode() {
        let unicode_plaintext = "🔐 API密钥 12345 パスワード";
        let master_password = "unicode_password_🔑";
        
        let encrypted = EncryptedCredential::encrypt(unicode_plaintext, master_password);
        let decrypted = encrypted.decrypt(master_password).unwrap();
        
        assert_eq!(decrypted, unicode_plaintext);
    }

    #[test]
    fn test_key_store_concurrent_access() {
        let master_key = "test_master_key";
        let key_store = std::sync::Arc::new(tokio::sync::Mutex::new(
            KeyStore::with_master_key(master_key.to_string()).unwrap()
        ));
        
        let mut handles = vec![];
        
        // Spawn multiple tasks to store credentials concurrently
        for i in 0..5 {
            let key_store_clone = Arc::clone(&key_store);
            let handle = tokio::spawn(async move {
                let mut store = key_store_clone.lock().await;
                let credentials = ExchangeCredentials {
                    exchange: match i {
                        0 => ExchangeId::OKX,
                        1 => ExchangeId::ByBit,
                        2 => ExchangeId::MEXC,
                        3 => ExchangeId::GateIo,
                        _ => ExchangeId::Kraken,
                    },
                    api_key: format!("key_{}", i),
                    api_secret: format!("secret_{}", i),
                    passphrase: if i == 0 { Some(format!("pass_{}", i)) } else { None },
                    sandbox: i % 2 == 0,
                    enabled: true,
                };
                
                store.store_credentials(credentials).unwrap();
            });
            handles.push(handle);
        }
        
        // Wait for all tasks to complete
        for handle in handles {
            handle.await.unwrap();
        }
        
        // Verify all credentials were stored
        let store = key_store.lock().await;
        assert_eq!(store.list_exchanges().len(), 5);
    }
}
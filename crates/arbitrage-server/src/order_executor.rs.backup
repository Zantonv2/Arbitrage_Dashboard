    #[test]
    fn test_decimal_calculations() {
        // Test profit calculation edge cases
        let buy_price = Decimal::new(50000, 0);
        let sell_price = Decimal::new(50100, 0);
        let quantity = Decimal::new(1, 0);
        
        // (50100 - 50000) / 50000 * 1 = 100 / 50000 = 0.002
        let expected_profit = (sell_price - buy_price) / buy_price * quantity;
        assert_eq!(expected_profit, Decimal::new(2, 3)); // 0.002
        
        // Test with different quantities
        let quantity_2 = Decimal::new(2, 0);
        let profit_2 = (sell_price - buy_price) / buy_price * quantity_2;
        assert_eq!(profit_2, Decimal::new(4, 3)); // 0.004
        
        // Test with zero buy price (should handle gracefully)
        let zero_buy_price = Decimal::ZERO;
        let profit_zero = (sell_price - zero_buy_price) / zero_buy_price * quantity;
        // This would panic in real code, so we need to handle it
        assert!(zero_buy_price == Decimal::ZERO);
    }

    #[tokio::test]
    async fn test_concurrent_execution() {
        let config = ExecutorConfig::default();
        let exchange_config = ExchangeManagerConfig::default();
        let exchange_manager = Arc::new(ExchangeManager::new(exchange_config));
        let executor = Arc::new(executor);
        
        // Test concurrent execution attempts
        let mut handles = vec![];
        
        for i in 0..3 {
            let executor_clone = Arc::clone(&executor);
            let handle = tokio::spawn(async move {
                let mut instruction = create_test_instruction();
                instruction.signal_id = Uuid::new_v4(); // Unique signal ID
                
                // This would require mocking for actual execution
                // For now, test validation
                executor_clone.validate_instruction(&instruction).await
            });
            handles.push(handle);
        }
        
        // Wait for all validations to complete
        let results: Vec<Result<(), ArbitrageError>> = futures::future::join_all(handles)
            .await
            .into_iter()
            .map(|r| r.unwrap())
            .collect();
        
        // All validations should succeed
        for result in results {
            assert!(result.is_ok());
        }
    }

    #[test]
    fn test_error_message_formatting() {
        let test_cases = vec![
            ("Connection timeout", "Connection timeout"),
            ("Insufficient balance", "Insufficient balance"),
            ("Order rejected", "Order rejected"),
        ];
        
        for (error_input, expected_output) in test_cases {
            let error_msg = format!("Execution failed: {}", error_input);
            assert!(error_msg.contains(expected_output));
        }
    }

    #[tokio::test]
    async fn test_rollback_scenarios() {
        // Test rollback logic for different scenarios
        let config = ExecutorConfig {
            enable_rollback: true,
            ..Default::default()
        };
        
        let exchange_config = ExchangeManagerConfig::default();
        let exchange_manager = Arc::new(ExchangeManager::new(exchange_config));
        let executor = OrderExecutor::new(config, exchange_manager);
        
        // Verify rollback is enabled
        assert!(executor.config.enable_rollback);
        
        // Test rollback disabled scenario
        let config_no_rollback = ExecutorConfig {
            enable_rollback: false,
            ..Default::default()
        };
        
        let executor_no_rollback = OrderExecutor::new(config_no_rollback, exchange_manager);
        assert!(!executor_no_rollback.config.enable_rollback);
    }

    #[test]
    fn test_constants_and_defaults() {
        let config = ExecutorConfig::default();
        
        // Verify reasonable defaults
        assert!(config.execution_timeout_ms > 0);
        assert!(config.execution_timeout_ms <= 30000); // Max 30 seconds
        assert!(config.max_slippage_percent > Decimal::ZERO);
        assert!(config.max_slippage_percent <= Decimal::ONE); // Max 100%
        assert!(config.min_profit_threshold >= Decimal::ZERO);
        assert!(config.max_position_size > Decimal::ZERO);
    }
}
    #[tokio::test]
    async fn test_get_config() {
        let config = ExecutorConfig {
            execution_timeout_ms: 10000,
            max_slippage_percent: Decimal::new(100, 4), // 1%
            enable_rollback: false,
            min_profit_threshold: Decimal::new(50, 4), // 0.5%
            max_position_size: Decimal::new(20000, 0), // $20,000
        };
        
        let exchange_config = ExchangeManagerConfig::default();
        let exchange_manager = Arc::new(ExchangeManager::new(exchange_config));
        let executor = OrderExecutor::new(config.clone(), exchange_manager);
        
        let retrieved_config = executor.get_config();
        assert_eq!(retrieved_config.execution_timeout_ms, 10000);
        assert_eq!(retrieved_config.max_slippage_percent, Decimal::new(100, 4));
        assert!(!retrieved_config.enable_rollback);
        assert_eq!(retrieved_config.min_profit_threshold, Decimal::new(50, 4));
        assert_eq!(retrieved_config.max_position_size, Decimal::new(20000, 0));
    }

    #[tokio::test]
    async fn test_update_config() {
        let initial_config = ExecutorConfig::default();
        let exchange_config = ExchangeManagerConfig::default();
        let exchange_manager = Arc::new(ExchangeManager::new(exchange_config));
        let mut executor = OrderExecutor::new(initial_config, exchange_manager);
        
        let new_config = ExecutorConfig {
            execution_timeout_ms: 15000,
            max_slippage_percent: Decimal::new(75, 4), // 0.75%
            enable_rollback: true,
            min_profit_threshold: Decimal::new(25, 4), // 0.25%
            max_position_size: Decimal::new(15000, 0), // $15,000
        };
        
        executor.update_config(new_config.clone());
        
        let retrieved_config = executor.get_config();
        assert_eq!(retrieved_config.execution_timeout_ms, 15000);
        assert_eq!(retrieved_config.max_slippage_percent, Decimal::new(75, 4));
        assert!(retrieved_config.enable_rollback);
        assert_eq!(retrieved_config.min_profit_threshold, Decimal::new(25, 4));
        assert_eq!(retrieved_config.max_position_size, Decimal::new(15000, 0));
    }

    #[tokio::test]
    async fn test_order_request_creation() {
        let instruction = create_test_instruction();
        
        let buy_request = OrderRequest {
            symbol: instruction.buy_order.symbol.clone(),
            side: OrderSide::Buy,
            order_type: OrderType::Market,
            quantity: instruction.buy_order.quantity,
            price: instruction.buy_order.price,
            time_in_force: TimeInForce::IOC,
            client_order_id: Some(format!("arb_buy_{}", instruction.signal_id)),
        };
        
        let sell_request = OrderRequest {
            symbol: instruction.sell_order.symbol.clone(),
            side: OrderSide::Sell,
            order_type: OrderType::Market,
            quantity: instruction.sell_order.quantity,
            price: instruction.sell_order.price,
            time_in_force: TimeInForce::IOC,
            client_order_id: Some(format!("arb_sell_{}", instruction.signal_id)),
        };
        
        // Verify buy request
        assert_eq!(buy_request.side, OrderSide::Buy);
        assert_eq!(buy_request.order_type, OrderType::Market);
        assert_eq!(buy_request.time_in_force, TimeInForce::IOC);
        assert!(buy_request.client_order_id.unwrap().starts_with("arb_buy_"));
        
        // Verify sell request
        assert_eq!(sell_request.side, OrderSide::Sell);
        assert_eq!(sell_request.order_type, OrderType::Market);
        assert_eq!(sell_request.time_in_force, TimeInForce::IOC);
        assert!(sell_request.client_order_id.unwrap().starts_with("arb_sell_"));
    }

    #[tokio::test]
    async fn test_rollback_order_request_creation() {
        let original_order = create_test_order_response(
            ExchangeId::OKX,
            OrderSide::Buy,
            Decimal::new(50000, 0),
            Decimal::new(1, 0),
        );
        
        let rollback_request = OrderRequest {
            symbol: original_order.symbol.clone(),
            side: OrderSide::Sell, // Opposite side for rollback
            order_type: OrderType::Market,
            quantity: original_order.quantity,
            price: None, // Market order for rollback
            time_in_force: TimeInForce::IOC,
            client_order_id: Some(format!("rollback_{}", original_order.order_id)),
        };
        
        // Verify rollback request
        assert_eq!(rollback_request.side, OrderSide::Sell);
        assert_eq!(rollback_request.order_type, OrderType::Market);
        assert_eq!(rollback_request.time_in_force, TimeInForce::IOC);
        assert!(rollback_request.price.is_none()); // Market order
        assert!(rollback_request.client_order_id.unwrap().starts_with("rollback_"));
    }

    #[test]
    fn test_execution_result_creation() {
        let signal_id = Uuid::new_v4();
        let buy_order = create_test_order_response(
            ExchangeId::OKX,
            OrderSide::Buy,
            Decimal::new(50000, 0),
            Decimal::new(1, 0),
        );
        let sell_order = create_test_order_response(
            ExchangeId::ByBit,
            OrderSide::Sell,
            Decimal::new(50100, 0),
            Decimal::new(1, 0),
        );
        
        let result = ExecutionResult {
            signal_id,
            success: true,
            buy_order: Some(buy_order),
            sell_order: Some(sell_order),
            actual_profit: Some(Decimal::new(100, 0)),
            execution_time_ms: 2500,
            error_message: None,
            rollback_performed: false,
        };
        
        assert_eq!(result.signal_id, signal_id);
        assert!(result.success);
        assert!(result.buy_order.is_some());
        assert!(result.sell_order.is_some());
        assert_eq!(result.actual_profit, Some(Decimal::new(100, 0)));
        assert_eq!(result.execution_time_ms, 2500);
        assert!(result.error_message.is_none());
        assert!(!result.rollback_performed);
    }

    #[test]
    fn test_execution_result_failure() {
        let signal_id = Uuid::new_v4();
        
        let result = ExecutionResult {
            signal_id,
            success: false,
            buy_order: None,
            sell_order: None,
            actual_profit: None,
            execution_time_ms: 1000,
            error_message: Some("Exchange connection failed".to_string()),
            rollback_performed: false,
        };
        
        assert_eq!(result.signal_id, signal_id);
        assert!(!result.success);
        assert!(result.buy_order.is_none());
        assert!(result.sell_order.is_none());
        assert!(result.actual_profit.is_none());
        assert_eq!(result.execution_time_ms, 1000);
        assert_eq!(result.error_message, Some("Exchange connection failed".to_string()));
        assert!(!result.rollback_performed);
    }


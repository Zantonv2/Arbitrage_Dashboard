    #[test]
    fn test_execution_result_clone() {
        let signal_id = Uuid::new_v4();
        let result = ExecutionResult {
            signal_id,
            success: false,
            buy_order: Some(create_test_order_response(
                ExchangeId::OKX,
                OrderSide::Buy,
                Decimal::new(50000, 0),
                Decimal::new(1, 0),
            )),
            sell_order: None,
            actual_profit: None,
            execution_time_ms: 2000,
            error_message: Some("Test error".to_string()),
            rollback_performed: true,
        };
        
        let cloned = result.clone();
        assert_eq!(result.signal_id, cloned.signal_id);
        assert_eq!(result.success, cloned.success);
        assert_eq!(result.execution_time_ms, cloned.execution_time_ms);
        assert_eq!(result.rollback_performed, cloned.rollback_performed);
        assert_eq!(result.error_message, cloned.error_message);
    }

    #[tokio::test]
    async fn test_order_executor_new() {
        let config = ExecutorConfig::default();
        let exchange_config = ExchangeManagerConfig {
            enabled_exchanges: vec![ExchangeId::OKX, ExchangeId::ByBit],
            health_check_interval_seconds: 30,
            max_reconnect_attempts: 5,
            event_buffer_size: 1000,
            rate_limits: Default::default(),
            auto_reconnect: true,
            max_parallel_connections: 5,
        };
        
        let exchange_manager = Arc::new(ExchangeManager::new(exchange_config));
        let executor = OrderExecutor::new(config, exchange_manager);
        
        // Verify executor was created
        assert_eq!(executor.config.execution_timeout_ms, 5000);
        assert!(executor.config.enable_rollback);
    }

    #[tokio::test]
    async fn test_validate_instruction_valid() {
        let config = ExecutorConfig::default();
        let exchange_config = ExchangeManagerConfig::default();
        let exchange_manager = Arc::new(ExchangeManager::new(exchange_config));
        let executor = OrderExecutor::new(config, exchange_manager);
        
        let instruction = create_test_instruction();
        
        // Should pass validation
        let result = executor.validate_instruction(&instruction).await;
        assert!(result.is_ok());
    }

    #[tokio::test]
    async fn test_validate_instruction_profit_too_low() {
        let mut config = ExecutorConfig::default();
        config.min_profit_threshold = Decimal::new(200, 0); // $200 minimum
        
        let exchange_config = ExchangeManagerConfig::default();
        let exchange_manager = Arc::new(ExchangeManager::new(exchange_config));
        let executor = OrderExecutor::new(config, exchange_manager);
        
        let mut instruction = create_test_instruction();
        instruction.expected_profit = Decimal::new(100, 0); // Only $100 profit
        
        let result = executor.validate_instruction(&instruction).await;
        assert!(result.is_err());
        
        if let Err(ArbitrageError::Execution(msg)) = result {
            assert!(msg.contains("Profit"));
            assert!(msg.contains("below threshold"));
        } else {
            panic!("Expected Execution error");
        }
    }

    #[tokio::test]
    async fn test_validate_instruction_position_too_large() {
        let mut config = ExecutorConfig::default();
        config.max_position_size = Decimal::new(25000, 0); // $25,000 max
        
        let exchange_config = ExchangeManagerConfig::default();
        let exchange_manager = Arc::new(ExchangeManager::new(exchange_config));
        let executor = OrderExecutor::new(config, exchange_manager);
        
        let mut instruction = create_test_instruction();
        instruction.buy_order.price = Some(Decimal::new(30000, 0)); // $30,000 BTC
        instruction.buy_order.quantity = Decimal::new(1, 0); // 1 BTC = $30,000 position
        
        let result = executor.validate_instruction(&instruction).await;
        assert!(result.is_err());
        
        if let Err(ArbitrageError::Execution(msg)) = result {
            assert!(msg.contains("Position size"));
            assert!(msg.contains("exceeds limit"));
        } else {
            panic!("Expected Execution error");
        }
    }


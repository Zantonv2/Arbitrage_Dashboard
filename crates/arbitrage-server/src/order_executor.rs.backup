    #[tokio::test]
    async fn test_calculate_actual_profit() {
        let config = ExecutorConfig::default();
        let exchange_config = ExchangeManagerConfig::default();
        let exchange_manager = Arc::new(ExchangeManager::new(exchange_config));
        let executor = OrderExecutor::new(config, exchange_manager);
        
        let buy_order = create_test_order_response(
            ExchangeId::OKX,
            OrderSide::Buy,
            Decimal::new(50000, 0), // Bought at $50,000
            Decimal::new(1, 0), // 1 BTC
        );
        
        let sell_order = create_test_order_response(
            ExchangeId::ByBit,
            OrderSide::Sell,
            Decimal::new(50100, 0), // Sold at $50,100
            Decimal::new(1, 0), // 1 BTC
        );
        
        let profit = executor.calculate_actual_profit(&buy_order, &sell_order);
        
        // Expected profit: (50100 - 50000) / 50000 * 1 = 0.002 = 0.2%
        let expected_profit = Decimal::new(2, 3); // 0.002
        assert_eq!(profit, expected_profit);
    }


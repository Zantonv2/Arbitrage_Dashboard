#[cfg(test)]
mod tests {
    use super::*;
    use arbitrage_core::{
        types::{ExchangeId, ExecutionInstruction, Order},
        ArbitrageError,
    };
    use exchange_connectors::{
        connector::{OrderRequest, OrderResponse, OrderSide, OrderType, TimeInForce},
        ExchangeManager, ExchangeManagerConfig,
    };
    use rust_decimal::Decimal;
    use std::sync::Arc;
    use std::time::Duration;
    use uuid::Uuid;
    
    // Mock types for testing
    #[derive(Debug, Clone)]
    struct ExecutorConfig {
        execution_timeout_ms: u64,
        max_slippage_percent: Decimal,
        enable_rollback: bool,
        min_profit_threshold: Decimal,
        max_position_size: Decimal,
    }
    
    impl Default for ExecutorConfig {
        fn default() -> Self {
            Self {
                execution_timeout_ms: 5000,
                max_slippage_percent: Decimal::new(50, 4), // 0.5%
                enable_rollback: true,
                min_profit_threshold: Decimal::new(10, 4), // 0.1%
                max_position_size: Decimal::new(10000, 0), // $10,000
            }
        }
    }
    
    #[derive(Debug, Clone)]
    struct ExecutionResult {
        signal_id: Uuid,
        success: bool,
        buy_order: Option<OrderResponse>,
        sell_order: Option<OrderResponse>,
        actual_profit: Option<Decimal>,
        execution_time_ms: u64,
        error_message: Option<String>,
        rollback_performed: bool,
    }
    
    #[derive(Debug, Clone)]
    struct OrderExecutor {
        config: ExecutorConfig,
    }
    
    impl OrderExecutor {
        fn new(config: ExecutorConfig) -> Self {
            Self { config }
        }
        
        async fn execute_instruction(&self, _instruction: ExecutionInstruction) -> ExecutionResult {
            ExecutionResult {
                signal_id: Uuid::new_v4(),
                success: true,
                buy_order: None,
                sell_order: None,
                actual_profit: Some(Decimal::ZERO),
                execution_time_ms: 1000,
                error_message: None,
                rollback_performed: false,
            }
        }
    }

    // Mock helper function to create test execution instruction
    fn create_test_instruction() -> ExecutionInstruction {
        let signal_id = Uuid::new_v4();
        let symbol = arbitrage_core::types::Symbol::new("BTC", "USDT");
        
        ExecutionInstruction {
            id: signal_id,
            signal_id,
            buy_order: Order {
                exchange: ExchangeId::OKX,
                symbol: symbol.clone(),
                side: arbitrage_core::types::OrderSide::Buy,
                order_type: arbitrage_core::types::OrderType::Market,
                quantity: Decimal::new(1, 0), // 1 BTC
                price: Some(Decimal::new(50000, 0)), // $50,000
                expected_fee: Decimal::new(5, 1), // $0.50
            },
            sell_order: Order {
                exchange: ExchangeId::ByBit,
                symbol: symbol.clone(),
                side: arbitrage_core::types::OrderSide::Sell,
                order_type: arbitrage_core::types::OrderType::Market,
                quantity: Decimal::new(1, 0), // 1 BTC
                price: Some(Decimal::new(50100, 0)), // $50,100
                expected_fee: Decimal::new(5, 1), // $0.50
            },
            expected_profit: Decimal::new(100, 0), // $100 profit
            worst_case_profit: Decimal::new(50, 0), // $50 worst case
            total_fees: Decimal::new(1, 0), // $1 total fees
            confidence: Decimal::new(8, 1), // 0.8 confidence
            created_at: chrono::Utc::now(),
            expires_at: chrono::Utc::now() + chrono::Duration::minutes(5),
            validation_errors: vec![],
        }
    }

    // Mock helper function to create test order response
    fn create_test_order_response(
        exchange: ExchangeId,
        side: OrderSide,
        price: Decimal,
        quantity: Decimal,
    ) -> OrderResponse {
        OrderResponse {
            order_id: format!("order_{}", Uuid::new_v4()),
            client_order_id: Some(format!("client_{}", Uuid::new_v4())),
            exchange,
            symbol: arbitrage_core::types::Symbol::new("BTC", "USDT"),
            side,
            order_type: OrderType::Market,
            quantity,
            price: Some(price),
            filled_quantity: Some(quantity),
            average_price: Some(price),
            status: exchange_connectors::connector::OrderStatus::Filled,
            expected_fee: Some(Decimal::new(5, 1)),
            actual_fee: Some(Decimal::new(5, 1)),
            timestamp: chrono::Utc::now(),
        }
    }

    #[test]
    fn test_executor_config_default() {
        let config = ExecutorConfig::default();
        
        assert_eq!(config.execution_timeout_ms, 5000);
        assert_eq!(config.max_slippage_percent, Decimal::new(50, 4)); // 0.5%
        assert!(config.enable_rollback);
        assert_eq!(config.min_profit_threshold, Decimal::new(10, 4)); // 0.1%
        assert_eq!(config.max_position_size, Decimal::new(10000, 0)); // $10,000
    }

    #[test]
    fn test_executor_config_debug() {
        let config = ExecutorConfig {
            execution_timeout_ms: 3000,
            max_slippage_percent: Decimal::new(75, 4), // 0.75%
            enable_rollback: false,
            min_profit_threshold: Decimal::new(5, 4), // 0.05%
            max_position_size: Decimal::new(5000, 0), // $5,000
        };
        
        let debug_str = format!("{:?}", config);
        assert!(debug_str.contains("ExecutorConfig"));
        assert!(debug_str.contains("execution_timeout_ms: 3000"));
    }

    #[test]
    fn test_executor_config_clone() {
        let config = ExecutorConfig::default();
        let cloned = config.clone();
        
        assert_eq!(config.execution_timeout_ms, cloned.execution_timeout_ms);
        assert_eq!(config.max_slippage_percent, cloned.max_slippage_percent);
        assert_eq!(config.enable_rollback, cloned.enable_rollback);
        assert_eq!(config.min_profit_threshold, cloned.min_profit_threshold);
        assert_eq!(config.max_position_size, cloned.max_position_size);
    }

    #[test]
    fn test_execution_result_debug() {
        let signal_id = Uuid::new_v4();
        let result = ExecutionResult {
            signal_id,
            success: true,
            buy_order: None,
            sell_order: None,
            actual_profit: Some(Decimal::new(100, 0)),
            execution_time_ms: 1500,
            error_message: None,
            rollback_performed: false,

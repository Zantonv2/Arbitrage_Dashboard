    #[tokio::test]
    async fn test_execute_arbitrage_validation_failure() {
        let config = ExecutorConfig::default();
        let exchange_config = ExchangeManagerConfig::default();
        let exchange_manager = Arc::new(ExchangeManager::new(exchange_config));
        let executor = OrderExecutor::new(config, exchange_manager);
        
        let mut instruction = create_test_instruction();
        instruction.expected_profit = Decimal::new(-1, 0); // Negative profit
        
        let result = executor.execute_arbitrage(&instruction).await;
        

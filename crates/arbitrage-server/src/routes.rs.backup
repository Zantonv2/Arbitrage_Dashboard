    // Mock implementations for request validation
    impl PrepareExecutionRequest {
        fn validate(&self) -> Result<(), Vec<String>> {
            let mut errors = vec![];
            
            // Validate signal_id is a valid UUID
            if uuid::Uuid::parse_str(&self.signal_id).is_err() {
                errors.push("Invalid UUID format for signal_id".to_string());
            }
            
            // Validate quantity if provided
            if let Some(qty) = self.quantity {
                if qty <= 0.0 {
                    errors.push("Quantity must be a positive number".to_string());
                }
            }
            
            if errors.is_empty() {
                Ok(())
            } else {
                Err(errors)
            }
        }
    }
    
    impl LoginRequest {
        fn validate(&self) -> Result<(), Vec<String>> {
            let mut errors = vec![];
            
            // Validate username
            if self.username.len() < 3 {
                errors.push("Username must be at least 3 characters".to_string());
            }
            if self.username.len() > 50 {
                errors.push("Username must be at most 50 characters".to_string());
            }
            if !self.username.chars().all(|c| c.is_alphanumeric() || c == '_') {
                errors.push("Username can only contain alphanumeric characters and underscores".to_string());
            }
            
            // Validate password
            if self.password.len() < 6 {
                errors.push("Password must be at least 6 characters".to_string());
            }
            
            if errors.is_empty() {
                Ok(())
            } else {
                Err(errors)
            }
        }
    }

    // Mock helper function to create a test app state
    async fn create_test_app_state() -> AppState {
        let config = Config::default();
        let storage_config = arbitrage_core::storage::StorageConfig {
            database_path: ":memory:".to_string(),
            max_signal_history: 100,
            max_execution_history: 50,
            enable_compression: false,
        };
        let storage = Arc::new(StorageService::new(storage_config).await.unwrap());
        let arbitrage_engine = Arc::new(ArbitrageEngine::new(
            config.clone(),
            Arc::new(arbitrage_core::normalizer::Normalizer::new()),
            Arc::new(arbitrage_core::confidence_scorer::ConfidenceScorer::new(
                arbitrage_core::confidence_scorer::ConfidenceConfig::default(),
            )),
            Arc::new(arbitrage_core::size_calculator::SizeCalculator::new(
                arbitrage_core::size_calculator::SizeConfig::default(),
            )),
            Arc::new(arbitrage_core::execution_preparer::ExecutionPreparer::new(
                arbitrage_core::execution_preparer::ExecutionConfig::default(),
            )),
            storage.clone(),
        ).unwrap().0);
        let strategy_registry = Arc::new(StrategyRegistry::new());
        let bridge = Arc::new(Mutex::new(
            crate::bridge::ArbitrageBridge::new(
                config.clone(),
                arbitrage_engine.clone(),
                strategy_registry.clone(),
            ).await.unwrap(),
        ));

        AppState {
            config: Arc::new(config),
            arbitrage_engine,
            storage,
            strategy_registry,
            bridge,
            jwt_secret: Arc::new("test_secret".to_string()),
        }
    }

    #[test]
    fn test_signals_query_deserialization() {
        let json_str = r#"
        {
            "limit": 50,
            "offset": 10,
            "symbol": "BTC-USDT",
            "exchange": "okx",
            "min_profit": 0.5,
            "min_confidence": 0.8
        }
        "#;
        
        let query: SignalsQuery = serde_json::from_str(json_str).unwrap();
        
        assert_eq!(query.limit, Some(50));
        assert_eq!(query.offset, Some(10));
        assert_eq!(query.symbol, Some("BTC-USDT".to_string()));
        assert_eq!(query.exchange, Some("okx".to_string()));
        assert_eq!(query.min_profit, Some(0.5));
        assert_eq!(query.min_confidence, Some(0.8));
    }
        let json_str = r#"
        {
            "limit": 50,
            "offset": 10,
            "symbol": "BTC-USDT",
            "exchange": "okx",
            "min_profit": 0.5,
            "min_confidence": 0.8
        }
        "#;
        
        let query: SignalsQuery = serde_json::from_str(json_str).unwrap();
        
        assert_eq!(query.limit, Some(50));
        assert_eq!(query.offset, Some(10));
        assert_eq!(query.symbol, Some("BTC-USDT".to_string()));
        assert_eq!(query.exchange, Some("okx".to_string()));
        assert_eq!(query.min_profit, Some(0.5));
        assert_eq!(query.min_confidence, Some(0.8));
    }


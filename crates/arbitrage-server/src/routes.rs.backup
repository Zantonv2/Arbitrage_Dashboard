    #[test]
    fn test_order_preview_serialization() {
        let order_preview = OrderPreview {
            exchange: "okx".to_string(),
            symbol: "BTC-USDT".to_string(),
            side: "buy".to_string(),
            quantity: 1.5,
            price: Some(50000.0),
            estimated_cost: 75000.0,
            estimated_fee: 7.5,
        };
        
        let json = serde_json::to_string(&order_preview).unwrap();
        let parsed: OrderPreview = serde_json::from_str(&json).unwrap();
        
        assert_eq!(parsed.exchange, "okx");
        assert_eq!(parsed.symbol, "BTC-USDT");
        assert_eq!(parsed.side, "buy");
        assert_eq!(parsed.quantity, 1.5);
        assert_eq!(parsed.price, Some(50000.0));
        assert_eq!(parsed.estimated_cost, 75000.0);
        assert_eq!(parsed.estimated_fee, 7.5);
    }

    #[test]
    fn test_prepare_execution_response_serialization() {
        let response = PrepareExecutionResponse {
            instruction_id: Uuid::new_v4().to_string(),
            buy_order: OrderPreview {
                exchange: "okx".to_string(),
                symbol: "BTC-USDT".to_string(),
                side: "buy".to_string(),
                quantity: 1.5,
                price: Some(50000.0),
                estimated_cost: 75000.0,
                estimated_fee: 7.5,
            },
            sell_order: OrderPreview {
                exchange: "bybit".to_string(),
                symbol: "BTC-USDT".to_string(),
                side: "sell".to_string(),
                quantity: 1.5,
                price: Some(50100.0),
                estimated_cost: 75150.0,
                estimated_fee: 7.5,
            },
            expected_profit: 150.0,
            worst_case_profit: 100.0,
            total_fees: 15.0,
            is_valid: true,
            validation_errors: vec![],
        };
        
        let json = serde_json::to_string(&response).unwrap();
        let parsed: PrepareExecutionResponse = serde_json::from_str(&json).unwrap();
        
        assert_eq!(parsed.instruction_id, response.instruction_id);
        assert_eq!(parsed.expected_profit, 150.0);
        assert!(parsed.is_valid);
        assert!(parsed.validation_errors.is_empty());
    }

    #[test]
    fn test_login_request_validation() {
        // Valid request
        let valid_request = LoginRequest {
            username: "testuser".to_string(),
            password: "password123".to_string(),
        };
        
        let result = valid_request.validate();
        assert!(result.is_ok(), "Valid login request should pass validation");
        
        // Username too short
        let short_username = LoginRequest {
            username: "ab".to_string(),
            password: "password123".to_string(),
        };
        
        let result = short_username.validate();
        assert!(result.is_err(), "Username too short should fail validation");
        
        // Username too long
        let long_username = LoginRequest {
            username: "a".repeat(51),
            password: "password123".to_string(),
        };
        
        let result = long_username.validate();
        assert!(result.is_err(), "Username too long should fail validation");
        
        // Username with special characters
        let special_chars = LoginRequest {
            username: "test@user".to_string(),
            password: "password123".to_string(),
        };
        
        let result = special_chars.validate();
        assert!(result.is_err(), "Username with special chars should fail validation");
        
        // Password too short
        let short_password = LoginRequest {
            username: "testuser".to_string(),
            password: "123".to_string(),
        };
        
        let result = short_password.validate();
        assert!(result.is_err(), "Password too short should fail validation");
    }

    #[test]
    fn test_login_request_serialization() {
        let request = LoginRequest {
            username: "testuser".to_string(),
            password: "password123".to_string(),
        };
        
        let json = serde_json::to_string(&request).unwrap();
        let parsed: LoginRequest = serde_json::from_str(&json).unwrap();
        
        assert_eq!(parsed.username, "testuser");
        assert_eq!(parsed.password, "password123");
    }

    #[test]
    fn test_login_response_serialization() {
        let response = LoginResponse {
            success: true,
            token: Some("jwt_token_here".to_string()),
            expires_at: Some("2024-01-01T00:00:00Z".to_string()),
            message: "Login successful".to_string(),
        };
        
        let json = serde_json::to_string(&response).unwrap();
        let parsed: LoginResponse = serde_json::from_str(&json).unwrap();
        
        assert!(parsed.success);
        assert_eq!(parsed.token, Some("jwt_token_here".to_string()));
        assert_eq!(parsed.expires_at, Some("2024-01-01T00:00:00Z".to_string()));
        assert_eq!(parsed.message, "Login successful");
    }

    #[tokio::test]
    async fn test_get_signals_empty_query() {
        let state = create_test_app_state().await;
        let params = Query(SignalsQuery {
            limit: None,
            offset: None,
            symbol: None,
            exchange: None,
            min_profit: None,
            min_confidence: None,
        });
        
        let result = get_signals(State(state), params).await;
        
        // Should return success even with no signals
        assert!(result.is_ok());
        let response = result.unwrap();
        let response_json = serde_json::to_value(response).unwrap();
        
        assert_eq!(response_json["signals"].as_array().unwrap().len(), 0);
        assert_eq!(response_json["total"], 0);
    }


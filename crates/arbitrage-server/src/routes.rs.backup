    #[test]
    fn test_prepare_execution_request_validation() {
        // Valid request
        let valid_request = PrepareExecutionRequest {
            signal_id: Uuid::new_v4().to_string(),
            quantity: Some(1.5),
        };
        
        let result = valid_request.validate();
        assert!(result.is_ok(), "Valid request should pass validation");
        
        // Invalid signal_id
        let invalid_request = PrepareExecutionRequest {
            signal_id: "invalid-uuid".to_string(),
            quantity: Some(1.5),
        };
        
        let result = invalid_request.validate();
        assert!(result.is_err(), "Invalid UUID should fail validation");
        
        let errors = result.unwrap_err();
        assert!(errors.iter().any(|e| e.contains("UUID format")));
    }


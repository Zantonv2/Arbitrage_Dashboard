    #[tokio::test]
    async fn test_get_exchange_status() {
        let state = create_test_app_state().await;
        
        let result = get_exchange_status(State(state)).await;
        
        assert!(result.is_ok());
        let response = result.unwrap();
        let response_json = serde_json::to_value(response).unwrap();
        
        assert!(response_json["connected_exchanges"].is_number());
        assert!(response_json["total_exchanges"].is_number());
        assert!(response_json["total_messages"].is_number());
        assert!(response_json["total_errors"].is_number());
        assert!(response_json["active_symbols"].is_number());
        assert!(response_json["last_updated"].is_string());
    }


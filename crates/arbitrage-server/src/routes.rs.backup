    #[tokio::test]
    async fn test_prepare_execution_invalid_request() {
        let state = create_test_app_state().await;
        let invalid_request = PrepareExecutionRequest {
            signal_id: "invalid-uuid".to_string(),
            quantity: Some(-1.0),
        };
        
        let result = prepare_execution(State(state), Json(invalid_request)).await;
        
        assert!(result.is_ok());
        let response = result.unwrap();
        
        assert!(!response.is_valid);
        assert!(!response.validation_errors.is_empty());
        assert!(response.validation_errors.iter().any(|e| e.contains("UUID format")));
        assert!(response.validation_errors.iter().any(|e| e.contains("positive number")));
    }


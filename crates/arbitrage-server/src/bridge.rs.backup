    // Mock types for testing
    #[derive(Debug, Clone, Default)]
    struct BridgeStats {
        connected_exchanges: usize,
        total_exchanges: usize,
        total_messages_received: u64,
        total_errors: u64,
        active_symbols: usize,
        cached_signals: usize,
        order_books_cached: usize,
    }
    
    #[derive(Debug, Clone)]
    struct ArbitrageBridge {
        config: Config,
        engine: Arc<ArbitrageEngine>,
        registry: Arc<StrategyRegistry>,
        stats: BridgeStats,
    }
    
    impl ArbitrageBridge {
        async fn new(
            config: Config,
            engine: Arc<ArbitrageEngine>,
            registry: Arc<StrategyRegistry>,
        ) -> Result<Self, Box<dyn std::error::Error>> {
            Ok(Self {
                config,
                engine,
                registry,
                stats: BridgeStats::default(),
            })
        }
        
        fn get_stats(&self) -> BridgeStats {
            self.stats.clone()
        }
        
        async fn get_trading_symbols(&self, _config: &Config) -> Vec<Symbol> {
            vec![] // Mock implementation
        }
    }

    // Mock helper function to create test config
    fn create_test_config() -> Config {
        let mut config = Config::default();
        
        // Add some exchange configurations
        config.exchanges.insert(
            ExchangeId::OKX,
            arbitrage_core::config::ExchangeConfig {
                enabled: true,
                api_key: "test_key".to_string(),
                api_secret: "test_secret".to_string(),
                sandbox: true,
                symbols: vec![
                    Symbol::new("BTC", "USDT"),
                    Symbol::new("ETH", "USDT"),
                ],
                rate_limits: Default::default(),
            },
        );
        
        config.exchanges.insert(
            ExchangeId::ByBit,
            arbitrage_core::config::ExchangeConfig {
                enabled: true,
                api_key: "test_key".to_string(),
                api_secret: "test_secret".to_string(),
                sandbox: true,
                symbols: vec![
                    Symbol::new("BTC", "USDT"),
                    Symbol::new("SOL", "USDT"),
                ],
                rate_limits: Default::default(),
            },
        );
        
        config
    }

    // Mock helper function to create test arbitrage engine
    async fn create_test_arbitrage_engine() -> Arc<ArbitrageEngine> {
        let config = Config::default();
        let storage_config = arbitrage_core::storage::StorageConfig {
            database_path: ":memory:".to_string(),
            max_signal_history: 100,
            max_execution_history: 50,
            enable_compression: false,
        };
        let storage = Arc::new(arbitrage_core::storage::StorageService::new(storage_config).await.unwrap());
        
        Arc::new(ArbitrageEngine::new(
            config,
            Arc::new(arbitrage_core::normalizer::Normalizer::new()),
            Arc::new(arbitrage_core::confidence_scorer::ConfidenceScorer::new(
                arbitrage_core::confidence_scorer::ConfidenceConfig::default(),
            )),
            Arc::new(arbitrage_core::size_calculator::SizeCalculator::new(
                arbitrage_core::size_calculator::SizeConfig::default(),
            )),
            Arc::new(arbitrage_core::execution_preparer::ExecutionPreparer::new(
                arbitrage_core::execution_preparer::ExecutionConfig::default(),
            )),
            storage,
        ).unwrap().0)
    }

    #[test]
    fn test_bridge_stats_default() {
        let stats = BridgeStats::default();
        
        assert_eq!(stats.connected_exchanges, 0);
        assert_eq!(stats.total_exchanges, 0);
        assert_eq!(stats.total_messages_received, 0);
        assert_eq!(stats.total_errors, 0);
        assert_eq!(stats.active_symbols, 0);
        assert_eq!(stats.cached_signals, 0);
        assert_eq!(stats.order_books_cached, 0);
    }

    #[test]
    fn test_bridge_stats_debug() {
        let stats = BridgeStats {
            connected_exchanges: 3,
            total_exchanges: 5,
            total_messages_received: 1000,
            total_errors: 10,
            active_symbols: 25,
            cached_signals: 50,
            order_books_cached: 75,
        };
        
        let debug_str = format!("{:?}", stats);
        assert!(debug_str.contains("BridgeStats"));
        assert!(debug_str.contains("connected_exchanges: 3"));
    }

    #[test]
    fn test_bridge_stats_clone() {
        let stats = BridgeStats {
            connected_exchanges: 2,
            total_exchanges: 4,
            total_messages_received: 500,
            total_errors: 5,
            active_symbols: 10,
            cached_signals: 20,
            order_books_cached: 30,
        };
        
        let cloned = stats.clone();
        assert_eq!(stats.connected_exchanges, cloned.connected_exchanges);
        assert_eq!(stats.total_exchanges, cloned.total_exchanges);
        assert_eq!(stats.total_messages_received, cloned.total_messages_received);
        assert_eq!(stats.total_errors, cloned.total_errors);
        assert_eq!(stats.active_symbols, cloned.active_symbols);
        assert_eq!(stats.cached_signals, cloned.cached_signals);
        assert_eq!(stats.order_books_cached, cloned.order_books_cached);
    }

    #[tokio::test]
    async fn test_get_trading_symbols_from_config() {
        let config = create_test_config();
        let arbitrage_engine = create_test_arbitrage_engine().await;
        let strategy_registry = Arc::new(StrategyRegistry::new());
        
        // Create bridge with test config
        let exchange_config = ExchangeManagerConfig {
            enabled_exchanges: config.exchanges.keys().cloned().collect(),
            health_check_interval_seconds: 30,
            max_reconnect_attempts: 5,
            event_buffer_size: 10000,
            rate_limits: Default::default(),
            auto_reconnect: true,
            max_parallel_connections: 10,
        };
        
        let exchange_manager = Arc::new(Mutex::new(ExchangeManager::new(exchange_config)));
        
        // Note: We can't fully test the bridge without mocking the exchange manager
        // But we can test the symbol extraction logic
        
        // Extract symbols from config (simulating the bridge logic)
        let mut symbols = Vec::new();
        for exchange_config in config.exchanges.values() {
            for symbol in &exchange_config.symbols {
                if !symbols.contains(symbol) {
                    symbols.push(symbol.clone());
                }
            }
        }
        
        // Should have unique symbols from all exchanges
        assert!(!symbols.is_empty());
        assert!(symbols.len() <= 4); // Max unique symbols from test config
        
        // Should contain BTC-USDT and ETH-USDT
        let btc_usdt = Symbol::new("BTC", "USDT");
        let eth_usdt = Symbol::new("ETH", "USDT");
        let sol_usdt = Symbol::new("SOL", "USDT");
        
        assert!(symbols.contains(&btc_usdt));
        assert!(symbols.contains(&eth_usdt));
        assert!(symbols.contains(&sol_usdt));
    }

    #[tokio::test]
    async fn test_get_trading_symbols_default_fallback() {
        // Test with empty config (should use defaults)
        let config = Config::default();
        
        let mut symbols = Vec::new();
        for exchange_config in config.exchanges.values() {
            for symbol in &exchange_config.symbols {
                if !symbols.contains(symbol) {
                    symbols.push(symbol.clone());
                }
            }
        }
        
        // Should be empty for default config
        assert!(symbols.is_empty());
        
        // Should use fallback symbols
        if symbols.is_empty() {
            symbols = vec![
                Symbol::new("BTC", "USDT"),
                Symbol::new("ETH", "USDT"),
                Symbol::new("SOL", "USDT"),
            ];
        }
        
        assert_eq!(symbols.len(), 3);
        assert_eq!(symbols[0], Symbol::new("BTC", "USDT"));
        assert_eq!(symbols[1], Symbol::new("ETH", "USDT"));
        assert_eq!(symbols[2], Symbol::new("SOL", "USDT"));
    }

    #[tokio::test]
    async fn test_handle_event_status_change() {
        let arbitrage_engine = create_test_arbitrage_engine().await;
        let strategy_registry = Arc::new(StrategyRegistry::new());
        
        let status_event = ConnectionEvent::StatusChange {
            exchange: ExchangeId::OKX,
            old_status: ConnectionStatus::Disconnected,
            new_status: ConnectionStatus::Connected,
            timestamp: chrono::Utc::now(),
        };
        
        let result = ArbitrageBridge::handle_event(&status_event, &arbitrage_engine, &strategy_registry).await;
        assert!(result.is_ok());
    }


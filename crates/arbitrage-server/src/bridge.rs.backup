    #[test]
    fn test_exchange_manager_config_creation() {
        let config = create_test_config();
        
        let exchange_config = ExchangeManagerConfig {
            enabled_exchanges: config.exchanges.keys().cloned().collect(),
            health_check_interval_seconds: 30,
            max_reconnect_attempts: 5,
            event_buffer_size: 10000,
            rate_limits: Default::default(),
            auto_reconnect: true,
            max_parallel_connections: 10,
        };
        
        assert_eq!(exchange_config.enabled_exchanges.len(), 2);
        assert!(exchange_config.enabled_exchanges.contains(&ExchangeId::OKX));
        assert!(exchange_config.enabled_exchanges.contains(&ExchangeId::ByBit));
        assert_eq!(exchange_config.health_check_interval_seconds, 30);
        assert_eq!(exchange_config.max_reconnect_attempts, 5);
        assert_eq!(exchange_config.event_buffer_size, 10000);
        assert!(exchange_config.auto_reconnect);
        assert_eq!(exchange_config.max_parallel_connections, 10);
    }

    #[tokio::test]
    async fn test_ticker_conversion() {
        let symbol = Symbol::new("BTC", "USDT");
        let connector_ticker = exchange_connectors::events::Ticker {
            exchange: ExchangeId::OKX,
            symbol: symbol.clone(),
            last_price: Decimal::new(50000, 0),
            bid_price: Some(Decimal::new(49999, 0)),
            ask_price: Some(Decimal::new(50001, 0)),
            volume_24h: Some(Decimal::new(1000, 0)),
            timestamp: chrono::Utc::now(),
        };
        
        // Test the conversion logic used in handle_market_data
        let engine_ticker = Ticker {
            symbol: connector_ticker.symbol.clone(),
            exchange: connector_ticker.exchange,
            last: connector_ticker.last_price,
            bid: connector_ticker.bid_price,
            ask: connector_ticker.ask_price,
            volume_24h: connector_ticker.volume_24h,
            change_24h: Decimal::ZERO,
            timestamp: connector_ticker.timestamp,
        };
        
        assert_eq!(engine_ticker.symbol, symbol);
        assert_eq!(engine_ticker.exchange, ExchangeId::OKX);
        assert_eq!(engine_ticker.last, Decimal::new(50000, 0));
        assert_eq!(engine_ticker.bid, Some(Decimal::new(49999, 0)));
        assert_eq!(engine_ticker.ask, Some(Decimal::new(50001, 0)));
        assert_eq!(engine_ticker.volume_24h, Some(Decimal::new(1000, 0)));
        assert_eq!(engine_ticker.change_24h, Decimal::ZERO);
    }

    #[tokio::test]
    async fn test_funding_rate_conversion() {
        let symbol = Symbol::new("BTC", "USDT");
        let connector_funding = exchange_connectors::events::FundingRate {
            exchange: ExchangeId::ByBit,
            symbol: symbol.clone(),
            funding_rate: Decimal::new(1, 4), // 0.0001
            predicted_rate: Some(Decimal::new(2, 4)), // 0.0002
            funding_time: chrono::Utc::now() + chrono::Duration::hours(8),
            timestamp: chrono::Utc::now(),
        };
        
        // Test the conversion logic used in handle_market_data
        let engine_funding = FundingRate {
            symbol: connector_funding.symbol.clone(),
            exchange: connector_funding.exchange,
            rate: connector_funding.funding_rate,
            predicted_rate: connector_funding.predicted_rate,
            next_funding: connector_funding.funding_time,
            timestamp: connector_funding.timestamp,
        };
        
        assert_eq!(engine_funding.symbol, symbol);
        assert_eq!(engine_funding.exchange, ExchangeId::ByBit);
        assert_eq!(engine_funding.rate, Decimal::new(1, 4));
        assert_eq!(engine_funding.predicted_rate, Some(Decimal::new(2, 4)));
        assert_eq!(engine_funding.next_funding, connector_funding.funding_time);
    }

    #[test]
    fn test_symbol_deduplication() {
        let mut symbols = Vec::new();
        
        // Add symbols with duplicates
        symbols.push(Symbol::new("BTC", "USDT"));
        symbols.push(Symbol::new("ETH", "USDT"));
        symbols.push(Symbol::new("BTC", "USDT")); // Duplicate
        symbols.push(Symbol::new("SOL", "USDT"));
        symbols.push(Symbol::new("ETH", "USDT")); // Duplicate
        
        // Deduplicate (simulate the bridge logic)
        let mut unique_symbols = Vec::new();
        for symbol in symbols {
            if !unique_symbols.contains(&symbol) {
                unique_symbols.push(symbol);
            }
        }
        
        assert_eq!(unique_symbols.len(), 3);
        assert!(unique_symbols.contains(&Symbol::new("BTC", "USDT")));
        assert!(unique_symbols.contains(&Symbol::new("ETH", "USDT")));
        assert!(unique_symbols.contains(&Symbol::new("SOL", "USDT")));
    }


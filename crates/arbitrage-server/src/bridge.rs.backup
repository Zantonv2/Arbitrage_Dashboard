    }

    #[tokio::test]
    async fn test_concurrent_symbol_processing() {
        let config = create_test_config();
        
        // Test concurrent symbol processing (simulate bridge behavior)
        let symbols: Vec<Symbol> = config.exchanges
            .values()
            .flat_map(|exchange_config| exchange_config.symbols.clone())
            .collect();
        
        // Process symbols concurrently
        let mut handles = vec![];
        for symbol in symbols {
            let handle = tokio::spawn(async move {
                // Simulate symbol processing
                tokio::time::sleep(std::time::Duration::from_millis(1)).await;
                symbol.to_pair()
            });
            handles.push(handle);
        }
        
        // Wait for all processing to complete
        let mut results = vec![];
        for handle in handles {
            results.push(handle.await.unwrap());
        }
        
        // Verify all symbols were processed
        assert!(!results.is_empty());
        
        // Should have unique symbol pairs
        let mut unique_pairs = std::collections::HashSet::new();
        for pair in results {
            unique_pairs.insert(pair);
        }
        
        assert!(!unique_pairs.is_empty());
    }
}
    #[test]
    fn test_constants() {
        assert_eq!(WS_AUTH_TIMEOUT_SECS, 10);
    }

    // Test message type priority (msg_type over type)
    #[tokio::test]
    async fn test_handle_client_message_priority() {
        let state = create_test_app_state().await;
        
        // Message with both fields - msg_type should take priority
        let priority_msg = json!({
            "msg_type": "ping",
            "type": "subscribe"
        });
        
        let result = handle_client_message(&priority_msg.to_string(), &state).await;
        assert!(result.is_ok());
        
        // Parse the message to verify priority logic
        let parsed: ClientMessage = serde_json::from_str(&priority_msg.to_string()).unwrap();
        let msg_type = if !parsed.msg_type.is_empty() {
            &parsed.msg_type
        } else {
            &parsed.r#type
        };
        
        assert_eq!(msg_type, "ping");
    }

    // Test WebSocket error scenarios
    #[test]
    fn test_websocket_error_conversion() {
        let error = WebSocketAuthError;
        
        // Test that it implements the required traits
        fn assert_error<E: std::error::Error + Send + Sync + 'static>() {}
        assert_error::<WebSocketAuthError>();
    }

    // Test JWT creation and validation integration
    #[tokio::test]
    async fn test_jwt_websocket_integration() {
        let state = create_test_app_state().await;
        let user_id = "integration_test_user";
        
        // Create token using server function
        let token = crate::server::create_jwt(user_id, &state.jwt_secret).unwrap();
        
        // Validate using WebSocket function
        let is_valid = validate_ws_token(&token, &state.jwt_secret);
        assert!(is_valid);
        
        // Validate using server function
        let is_valid_server = crate::server::validate_jwt(&token, &state.jwt_secret);
        assert!(is_valid_server);
    }

    // Test message serialization edge cases
    #[test]
    fn test_message_serialization_edge_cases() {
        // Test with special characters
        let auth_msg = WsAuthMessage {
            token: "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c".to_string(),
        };
        
        let json = serde_json::to_string(&auth_msg).unwrap();
        let parsed: WsAuthMessage = serde_json::from_str(&json).unwrap();
        
        assert_eq!(parsed.token, auth_msg.token);
        
        // Test with empty token
        let empty_auth_msg = WsAuthMessage {
            token: "".to_string(),
        };
        
        let json_empty = serde_json::to_string(&empty_auth_msg).unwrap();
        let parsed_empty: WsAuthMessage = serde_json::from_str(&json_empty).unwrap();
        
        assert_eq!(parsed_empty.token, "");
    }
}
    #[test]
    fn test_validate_ws_token_valid() {
        let secret = "test_secret";
        let user_id = "test_user";
        
        // Create a valid JWT token
        let claims = Claims {
            sub: user_id.to_string(),
            exp: (chrono::Utc::now().timestamp() + 3600) as u64,
            iat: chrono::Utc::now().timestamp() as u64,
        };
        
        let token = jsonwebtoken::encode(
            &Header::default(),
            &claims,
            &EncodingKey::from_secret(secret.as_bytes()),
        ).unwrap();
        
        let result = validate_ws_token(&token, secret);
        assert!(result, "Valid token should pass validation");
    }

    #[test]
    fn test_validate_ws_token_invalid() {
        let secret = "test_secret";
        let wrong_secret = "wrong_secret";
        let user_id = "test_user";
        
        // Create token with correct secret
        let claims = Claims {
            sub: user_id.to_string(),
            exp: (chrono::Utc::now().timestamp() + 3600) as u64,
            iat: chrono::Utc::now().timestamp() as u64,
        };
        
        let token = jsonwebtoken::encode(
            &Header::default(),
            &claims,
            &EncodingKey::from_secret(secret.as_bytes()),
        ).unwrap();
        
        // Try to validate with wrong secret
        let result = validate_ws_token(&token, wrong_secret);
        assert!(!result, "Token with wrong secret should fail validation");
    }

    #[test]
    fn test_validate_ws_token_expired() {
        let secret = "test_secret";
        let user_id = "test_user";
        
        // Create an expired token
        let past_timestamp = (chrono::Utc::now().timestamp() - 3600) as u64;
        let claims = Claims {
            sub: user_id.to_string(),
            exp: past_timestamp,
            iat: past_timestamp,
        };
        
        let token = jsonwebtoken::encode(
            &Header::default(),
            &claims,
            &EncodingKey::from_secret(secret.as_bytes()),
        ).unwrap();
        
        let result = validate_ws_token(&token, secret);
        assert!(!result, "Expired token should fail validation");
    }

    #[test]
    fn test_validate_ws_token_malformed() {
        let secret = "test_secret";
        let malformed_tokens = vec![
            "",
            "not.a.jwt",
            "invalid.token",
            "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.invalid",
        ];
        
        for token in malformed_tokens {
            let result = validate_ws_token(token, secret);
            assert!(!result, "Malformed token '{}' should fail validation", token);
        }
    }

    #[tokio::test]
    async fn test_authenticate_websocket_valid_token() {
        let state = create_test_app_state().await;
        
        // Create a mock WebSocket receiver with valid auth message
        let (tx, rx) = futures_util::channel::mpsc::channel(1);
        
        // Send valid auth message
        let auth_msg = WsAuthMessage {
            token: create_jwt("test_user", &state.jwt_secret).unwrap(),
        };
        let auth_json = serde_json::to_string(&auth_msg).unwrap();
        
        // This test would require more complex WebSocket mocking
        // For now, test the token validation logic separately
        let token = create_jwt("test_user", &state.jwt_secret).unwrap();
        let is_valid = validate_ws_token(&token, &state.jwt_secret);
        assert!(is_valid);
    }


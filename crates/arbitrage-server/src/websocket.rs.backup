    #[tokio::test]
    async fn test_websocket_handler_without_token() {
        let state = create_test_app_state().await;
        
        // Create query params without token
        let params = WsQueryParams { token: None };
        
        // Should fail validation
        let prevalidated = params.token
            .map(|token| validate_jwt(&token, &state.jwt_secret))
            .unwrap_or(false);
        
        assert!(!prevalidated);
    }


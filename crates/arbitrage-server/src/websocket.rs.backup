        config::Config,
        arbitrage_engine::ArbitrageEngine,
        storage::StorageService,
        strategies::StrategyRegistry,
    };
    use axum::{
        extract::{Query, State},
        http::{Request, Uri},
    };
    use futures_util::{SinkExt, StreamExt};
    use jsonwebtoken::{DecodingKey, EncodingKey, Header};
    use serde_json::json;

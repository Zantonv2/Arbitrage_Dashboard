#[cfg(test)]
mod tests {
    use super::*;
    use chrono::Utc;
    use uuid::Uuid;
    use serde::{Serialize, Deserialize};
    use std::sync::Arc;
    
    // Mock types for testing
    #[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
    enum AuditDecision {
        SignalDetected,
        SignalEmitted,
        ExecutionPrepared,
        ExecutionConfirmed,
        ExecutionRejected,
        OrderPlaced,
        OrderFilled,
        OrderCancelled,
        ErrorOccurred,
        ConfigChanged,
    }
    
    #[derive(Debug, Clone, Serialize, Deserialize)]
    struct AuditEntry {
        id: Uuid,
        timestamp: chrono::DateTime<chrono::Utc>,
        decision: AuditDecision,
        status: String,
        details: String,
        opportunity_id: Option<Uuid>,
        symbol: Option<String>,
        buy_exchange: Option<String>,
        sell_exchange: Option<String>,
        expected_profit: Option<String>,
        actual_profit: Option<String>,
    }
    
    impl AuditEntry {
        fn new(decision: AuditDecision, status: &str, details: &str) -> Self {
            Self {
                id: Uuid::new_v4(),
                timestamp: Utc::now(),
                decision,
                status: status.to_string(),
                details: details.to_string(),
                opportunity_id: None,
                symbol: None,
                buy_exchange: None,
                sell_exchange: None,
                expected_profit: None,
                actual_profit: None,
            }
        }
        
        fn with_opportunity(mut self, opportunity_id: Uuid, symbol: &str) -> Self {
            self.opportunity_id = Some(opportunity_id);
            self.symbol = Some(symbol.to_string());
            self
        }
        
        fn with_exchanges(mut self, buy_exchange: &str, sell_exchange: &str) -> Self {
            self.buy_exchange = Some(buy_exchange.to_string());
            self.sell_exchange = Some(sell_exchange.to_string());
            self
        }
        
        fn with_profit(mut self, expected_profit: &str, actual_profit: Option<&str>) -> Self {
            self.expected_profit = Some(expected_profit.to_string());
            self.actual_profit = actual_profit.map(|s| s.to_string());
            self
        }
    }
    
    #[derive(Debug, Clone, Default)]
    struct AuditLogger {
        max_entries: usize,
    }
    
    impl AuditLogger {
        fn new(max_entries: usize) -> Self {
            Self { max_entries }
        }
        
        async fn log(&self, _entry: AuditEntry) {
            // Mock implementation
        }
        
        async fn log_decision(&self, decision: AuditDecision, status: &str, details: &str) {
            let entry = AuditEntry::new(decision, status, details);
            self.log(entry).await;
        }
        
        async fn log_execution(
            &self,
            _opportunity_id: Uuid,
            _symbol: &str,
            _buy_exchange: &str,
            _sell_exchange: &str,
            _expected_profit: &str,
            _actual_profit: Option<&str>,
            _status: &str,
        ) {
            // Mock implementation
        }
        
        async fn log_error(&self, _error_type: &str, _context: &str) {
            // Mock implementation
        }
        
        async fn get_all_entries(&self) -> Vec<AuditEntry> {
            vec![] // Mock implementation
        }
        
        async fn get_entries_by_decision(&self, _decision: AuditDecision) -> Vec<AuditEntry> {
            vec![] // Mock implementation
        }
    }

    #[test]
    fn test_audit_decision_equality() {
        assert_eq!(AuditDecision::SignalDetected, AuditDecision::SignalDetected);
        assert_ne!(AuditDecision::SignalDetected, AuditDecision::SignalEmitted);
    }

    #[test]
    fn test_audit_decision_serialization() {
        let decision = AuditDecision::SignalDetected;
        
        let json = serde_json::to_string(&decision).unwrap();
        let parsed: AuditDecision = serde_json::from_str(&json).unwrap();
        
        assert_eq!(parsed, decision);
    }

    #[test]
    fn test_audit_entry_new() {
        let decision = AuditDecision::SignalDetected;
        let status = "detected";
        let details = "New arbitrage opportunity found";
        
        let entry = AuditEntry::new(decision, status, details);
        
        assert_eq!(entry.decision, decision);
        assert_eq!(entry.status, status);
        assert_eq!(entry.details, details);
        assert!(entry.opportunity_id.is_none());
        assert!(entry.symbol.is_none());
        assert!(entry.buy_exchange.is_none());
        assert!(entry.sell_exchange.is_none());
        assert!(entry.expected_profit.is_none());
        assert!(entry.actual_profit.is_none());
    }

    #[test]
    fn test_audit_entry_with_opportunity() {
        let decision = AuditDecision::ExecutionConfirmed;
        let status = "completed";
        let details = "Trade executed successfully";
        let opportunity_id = Uuid::new_v4();
        let symbol = "BTC-USDT";
        
        let entry = AuditEntry::new(decision, status, details)
            .with_opportunity(opportunity_id, symbol);
        
        assert_eq!(entry.opportunity_id, Some(opportunity_id));
        assert_eq!(entry.symbol, Some(symbol.to_string()));
    }

    #[test]
    fn test_audit_entry_with_exchanges() {
        let decision = AuditDecision::OrderPlaced;
        let status = "placed";
        let details = "Buy order placed";
        let buy_exchange = "okx";
        let sell_exchange = "bybit";
        
        let entry = AuditEntry::new(decision, status, details)
            .with_exchanges(buy_exchange, sell_exchange);
        
        assert_eq!(entry.buy_exchange, Some(buy_exchange.to_string()));
        assert_eq!(entry.sell_exchange, Some(sell_exchange.to_string()));
    }

    #[test]
    fn test_audit_entry_with_profit() {
        let decision = AuditDecision::ExecutionConfirmed;
        let status = "completed";
        let details = "Trade completed";
        let expected_profit = "150.50";
        let actual_profit = Some("145.25");
        
        let entry = AuditEntry::new(decision, status, details)
            .with_profit(expected_profit, actual_profit);
        
        assert_eq!(entry.expected_profit, Some(expected_profit.to_string()));
        assert_eq!(entry.actual_profit, Some(actual_profit.unwrap().to_string()));
    }

    #[test]
    fn test_audit_entry_with_profit_no_actual() {
        let decision = AuditDecision::ExecutionConfirmed;
        let status = "completed";
        let details = "Trade completed";
        let expected_profit = "150.50";
        
        let entry = AuditEntry::new(decision, status, details)
            .with_profit(expected_profit, None);
        
        assert_eq!(entry.expected_profit, Some(expected_profit.to_string()));
        assert_eq!(entry.actual_profit, None);
    }

    #[test]
    fn test_audit_entry_builder_pattern() {
        let opportunity_id = Uuid::new_v4();
        let symbol = "ETH-USDT";
        let buy_exchange = "mexc";
        let sell_exchange = "gateio";
        let expected_profit = "75.25";
        let actual_profit = Some("73.10");
        
        let entry = AuditEntry::new(
            AuditDecision::ExecutionConfirmed,
            "completed",
            "Arbitrage trade executed"
        )
        .with_opportunity(opportunity_id, symbol)
        .with_exchanges(buy_exchange, sell_exchange)
        .with_profit(expected_profit, actual_profit);
        
        assert_eq!(entry.decision, AuditDecision::ExecutionConfirmed);
        assert_eq!(entry.status, "completed");
        assert_eq!(entry.details, "Arbitrage trade executed");
        assert_eq!(entry.opportunity_id, Some(opportunity_id));
        assert_eq!(entry.symbol, Some(symbol.to_string()));
        assert_eq!(entry.buy_exchange, Some(buy_exchange.to_string()));
        assert_eq!(entry.sell_exchange, Some(sell_exchange.to_string()));
        assert_eq!(entry.expected_profit, Some(expected_profit.to_string()));
        assert_eq!(entry.actual_profit, Some(actual_profit.unwrap().to_string()));
    }

    #[test]
    fn test_audit_entry_serialization() {
        let entry = AuditEntry::new(
            AuditDecision::SignalDetected,
            "detected",
            "New opportunity found"
        )
        .with_opportunity(Uuid::new_v4(), "BTC-USDT")
        .with_exchanges("okx", "bybit")
        .with_profit("100.0", Some("95.5"));
        
        let json = serde_json::to_string(&entry).unwrap();
        let parsed: AuditEntry = serde_json::from_str(&json).unwrap();
        
        assert_eq!(parsed.decision, entry.decision);
        assert_eq!(parsed.status, entry.status);
        assert_eq!(parsed.details, entry.details);
        assert_eq!(parsed.opportunity_id, entry.opportunity_id);
        assert_eq!(parsed.symbol, entry.symbol);
        assert_eq!(parsed.buy_exchange, entry.buy_exchange);
        assert_eq!(parsed.sell_exchange, entry.sell_exchange);
        assert_eq!(parsed.expected_profit, entry.expected_profit);
        assert_eq!(parsed.actual_profit, entry.actual_profit);
    }

    #[tokio::test]
    async fn test_audit_logger_new() {
        let logger = AuditLogger::new(100);
        
        // Should start empty
        let entries = logger.get_all_entries().await;
        assert!(entries.is_empty());
    }

    #[tokio::test]
    async fn test_audit_logger_default() {
        let logger = AuditLogger::default();
        
        // Should start empty
        let entries = logger.get_all_entries().await;
        assert!(entries.is_empty());
    }

    #[tokio::test]
    async fn test_audit_logger_log_single_entry() {
        let logger = AuditLogger::new(10);
        let entry = AuditEntry::new(
            AuditDecision::SignalDetected,
            "detected",
            "Test signal"
        );
        
        logger.log(entry.clone()).await;
        
        let entries = logger.get_all_entries().await;
        assert_eq!(entries.len(), 1);
        assert_eq!(entries[0].decision, entry.decision);
        assert_eq!(entries[0].status, entry.status);
        assert_eq!(entries[0].details, entry.details);
    }

    #[tokio::test]
    async fn test_audit_logger_log_decision() {
        let logger = AuditLogger::new(10);
        
        logger.log_decision(
            AuditDecision::SignalEmitted,
            "emitted",
            "Signal sent to clients"
        ).await;
        
        let entries = logger.get_all_entries().await;
        assert_eq!(entries.len(), 1);
        assert_eq!(entries[0].decision, AuditDecision::SignalEmitted);
        assert_eq!(entries[0].status, "emitted");
        assert_eq!(entries[0].details, "Signal sent to clients");
    }

    #[tokio::test]
    async fn test_audit_logger_log_execution() {
        let logger = AuditLogger::new(10);
        let opportunity_id = Uuid::new_v4();
        let symbol = "BTC-USDT";
        let buy_exchange = "okx";
        let sell_exchange = "bybit";
        let expected_profit = "100.0";
        let actual_profit = Some("95.5");
        let status = "completed";
        
        logger.log_execution(
            opportunity_id,
            symbol,
            buy_exchange,
            sell_exchange,
            expected_profit,
            actual_profit,
            status,
        ).await;
        
        let entries = logger.get_all_entries().await;
        assert_eq!(entries.len(), 1);
        
        let entry = &entries[0];
        assert_eq!(entry.decision, AuditDecision::ExecutionConfirmed);
        assert_eq!(entry.status, status);
        assert_eq!(entry.details, "Trade executed");
        assert_eq!(entry.opportunity_id, Some(opportunity_id));
        assert_eq!(entry.symbol, Some(symbol.to_string()));
        assert_eq!(entry.buy_exchange, Some(buy_exchange.to_string()));
        assert_eq!(entry.sell_exchange, Some(sell_exchange.to_string()));
        assert_eq!(entry.expected_profit, Some(expected_profit.to_string()));
        assert_eq!(entry.actual_profit, Some(actual_profit.unwrap().to_string()));
    }

    #[tokio::test]
    async fn test_audit_logger_log_error() {
        let logger = AuditLogger::new(10);
        let error_type = "ConnectionError";
        let context = "Failed to connect to exchange";
        
        logger.log_error(error_type, context).await;
        
        let entries = logger.get_all_entries().await;
        assert_eq!(entries.len(), 1);
        
        let entry = &entries[0];
        assert_eq!(entry.decision, AuditDecision::ErrorOccurred);
        assert_eq!(entry.status, "error");
        assert_eq!(entry.details, context);
        assert_eq!(entry.expected_profit, Some("N/A".to_string()));
        assert_eq!(entry.actual_profit, None);
    }

    #[tokio::test]
    async fn test_audit_logger_max_entries() {
        let max_entries = 3;
        let logger = AuditLogger::new(max_entries);
        
        // Add more entries than the maximum
        for i in 0..(max_entries + 2) {
            logger.log_decision(
                AuditDecision::SignalDetected,
                "detected",
                &format!("Signal {}", i)
            ).await;
        }
        
        let entries = logger.get_all_entries().await;
        assert_eq!(entries.len(), max_entries);
        
        // Should keep the most recent entries
        assert_eq!(entries[0].details, "Signal 2");
        assert_eq!(entries[1].details, "Signal 3");
        assert_eq!(entries[2].details, "Signal 4");
    }

    #[tokio::test]
    async fn test_audit_logger_get_entries_by_decision() {
        let logger = AuditLogger::new(10);
        
        // Add different types of entries
        logger.log_decision(AuditDecision::SignalDetected, "detected", "Signal 1").await;
        logger.log_decision(AuditDecision::SignalEmitted, "emitted", "Signal 2").await;
        logger.log_decision(AuditDecision::SignalDetected, "detected", "Signal 3").await;
        logger.log_error("TestError", "Error context").await;
        logger.log_decision(AuditDecision::SignalDetected, "detected", "Signal 4").await;
        
        // Get only SignalDetected entries
        let detected_entries = logger.get_entries_by_decision(AuditDecision::SignalDetected).await;
        assert_eq!(detected_entries.len(), 3);
        
        for entry in &detected_entries {
            assert_eq!(entry.decision, AuditDecision::SignalDetected);
        }
        
        // Get only ErrorOccurred entries
        let error_entries = logger.get_entries_by_decision(AuditDecision::ErrorOccurred).await;
        assert_eq!(error_entries.len(), 1);
        assert_eq!(error_entries[0].decision, AuditDecision::ErrorOccurred);
        
        // Get entries for a decision that doesn't exist
        let execution_entries = logger.get_entries_by_decision(AuditDecision::ExecutionConfirmed).await;
        assert_eq!(execution_entries.len(), 0);
    }

    #[tokio::test]
    async fn test_audit_logger_concurrent_logging() {
        let logger = Arc::new(AuditLogger::new(100));
        let mut handles = vec![];
        
        // Spawn multiple tasks to log concurrently
        for i in 0..10 {
            let logger_clone = Arc::clone(&logger);
            let handle = tokio::spawn(async move {
                logger_clone.log_decision(
                    AuditDecision::SignalDetected,
                    "detected",
                    &format!("Concurrent signal {}", i)
                ).await;
            });
            handles.push(handle);
        }
        
        // Wait for all tasks to complete
        for handle in handles {
            handle.await.unwrap();
        }
        
        let entries = logger.get_all_entries().await;
        assert_eq!(entries.len(), 10);
        
        // Verify all entries were logged
        let mut found_signals = std::collections::HashSet::new();
        for entry in &entries {
            if let Some(signal_num) = entry.details.strip_prefix("Concurrent signal ") {
                found_signals.insert(signal_num.parse::<usize>().unwrap());
            }
        }
        
        assert_eq!(found_signals.len(), 10);
    }

    #[tokio::test]
    async fn test_audit_logger_fifo_behavior() {
        let max_entries = 2;
        let logger = AuditLogger::new(max_entries);
        
        // Add entries in order
        logger.log_decision(AuditDecision::SignalDetected, "detected", "First").await;
        logger.log_decision(AuditDecision::SignalEmitted, "emitted", "Second").await;
        logger.log_decision(AuditDecision::ExecutionConfirmed, "confirmed", "Third").await;
        
        let entries = logger.get_all_entries().await;
        assert_eq!(entries.len(), 2);
        
        // Should have removed the first entry (FIFO)
        assert_eq!(entries[0].details, "Second");
        assert_eq!(entries[1].details, "Third");
    }

    #[test]
    fn test_audit_entry_timestamp() {
        let before = Utc::now();
        let entry = AuditEntry::new(
            AuditDecision::SignalDetected,
            "detected",
            "Test"
        );
        let after = Utc::now();
        
        // Timestamp should be between before and after
        assert!(entry.timestamp >= before);
        assert!(entry.timestamp <= after);
    }

    #[test]
    fn test_audit_entry_id_unique() {
        let entry1 = AuditEntry::new(
            AuditDecision::SignalDetected,
            "detected",
            "Test 1"
        );
        let entry2 = AuditEntry::new(
            AuditDecision::SignalDetected,
            "detected",
            "Test 2"
        );
        
        // IDs should be unique
        assert_ne!(entry1.id, entry2.id);
    }

    #[test]
    fn test_all_audit_decision_variants() {
        let decisions = vec![
            AuditDecision::SignalDetected,
            AuditDecision::SignalEmitted,
            AuditDecision::ExecutionPrepared,
            AuditDecision::ExecutionConfirmed,
            AuditDecision::ExecutionRejected,
            AuditDecision::OrderPlaced,
            AuditDecision::OrderFilled,
            AuditDecision::OrderCancelled,
            AuditDecision::ErrorOccurred,
            AuditDecision::ConfigChanged,
        ];
        
        for decision in &decisions {
            // Test serialization
            let json = serde_json::to_string(decision).unwrap();
            let parsed: AuditDecision = serde_json::from_str(&json).unwrap();
            assert_eq!(parsed, *decision);
            
            // Test debug formatting
            let debug_str = format!("{:?}", decision);
            assert!(!debug_str.is_empty());
        }
    }

    #[tokio::test]
    async fn test_audit_logger_complex_entry() {
        let logger = AuditLogger::new(5);
        
        let complex_entry = AuditEntry::new(
            AuditDecision::ExecutionRejected,
            "rejected",
            "Arbitrage opportunity expired before execution"
        )
        .with_opportunity(Uuid::new_v4(), "SOL-USDT")
        .with_exchanges("mexc", "kraken")
        .with_profit("25.75", None);
        
        logger.log(complex_entry).await;
        
        let entries = logger.get_all_entries().await;
        assert_eq!(entries.len(), 1);
        
        let entry = &entries[0];
        assert_eq!(entry.decision, AuditDecision::ExecutionRejected);
        assert_eq!(entry.status, "rejected");
        assert_eq!(entry.symbol, Some("SOL-USDT".to_string()));
        assert_eq!(entry.buy_exchange, Some("mexc".to_string()));
        assert_eq!(entry.sell_exchange, Some("kraken".to_string()));
        assert_eq!(entry.expected_profit, Some("25.75".to_string()));
        assert_eq!(entry.actual_profit, None);
    }

    #[tokio::test]
    async fn test_audit_logger_filter_by_multiple_criteria() {
        let logger = AuditLogger::new(20);
        let opportunity_id = Uuid::new_v4();
        
        // Add various entries
        logger.log_decision(AuditDecision::SignalDetected, "detected", "Signal 1").await;
        logger.log_execution(
            opportunity_id,
            "BTC-USDT",
            "okx",
            "bybit",
            "100.0",
            Some("95.5"),
            "completed"
        ).await;
        logger.log_decision(AuditDecision::SignalDetected, "detected", "Signal 2").await;
        logger.log_error("NetworkError", "Connection timeout").await;
        
        // Test filtering by decision
        let detected = logger.get_entries_by_decision(AuditDecision::SignalDetected).await;
        assert_eq!(detected.len(), 2);
        
        let executions = logger.get_entries_by_decision(AuditDecision::ExecutionConfirmed).await;
        assert_eq!(executions.len(), 1);
        assert_eq!(executions[0].opportunity_id, Some(opportunity_id));
        
        let errors = logger.get_entries_by_decision(AuditDecision::ErrorOccurred).await;
        assert_eq!(errors.len(), 1);
        assert_eq!(errors[0].details, "Connection timeout");
    }
}